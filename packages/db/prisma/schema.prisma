// RemarkRound — канон имён. Смысл статусов: docs/STATUS.md
// pgvector: после migrate выполнить индекс из packages/db/README.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  business
  pm
  developer
  admin
}

enum DocumentKind {
  spec
  protocol
  addendum
  journal_source
}

enum DocumentStatus {
  uploaded
  parsed
  indexed
  failed
}

enum RoundStatus {
  open
  closed
}

enum RemarkStatus {
  imported
  needs_human_parse
  triaging
  awaiting_pm
  defect
  change_request
  unspecified
  duplicate
  cannot_tell
  ready_for_retest
  awaiting_business_close
  closed
  reopened
}

enum ScreenshotKind {
  original
  retest
  diff
}

enum AgentRunStatus {
  running
  awaiting_human
  persisted
  cancelled
  failed
}

enum ImportRowStatus {
  parsed
  needs_human_parse
  failed
}

/// Предложение модели до решения человека (docs/WS.md ProposedClass)
enum ProposedClass {
  defect_candidate
  change_request_candidate
  unspecified
  duplicate
  cannot_tell
}

/// Итог ретеста от модели (docs/GRAPH.md). Не closed: закрывает только бизнес.
enum RetestOutcome {
  likely_addressed
  likely_unchanged
  cannot_tell
}

enum VerdictCode {
  defect
  change_request
  unspecified
  duplicate
  cannot_tell
  rejected_binding
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  /// null — пользователь без пароля (задел под вход через Google): verifyPassword(null) всегда false
  passwordHash String?
  name         String
  /// Сторона при регистрации (ADR 005): подсказка для приглашений и право создавать проекты (только pm).
  /// Роль в конкретном проекте — всегда Membership.role.
  preferredRole Role?
  /// Смена пароля: токены с iat раньше этого момента недействительны (выход везде, включая MCP-токены)
  passwordChangedAt DateTime?
  memberships  Membership[]
  verdicts     HumanVerdict[]
  advices      DeveloperAdvice[]
  createdAt    DateTime     @default(now())
}

model Project {
  id          String         @id @default(uuid())
  name        String
  memberships Membership[]
  invitations Invitation[]
  documents   Document[]
  rounds      Round[]
  createdAt   DateTime       @default(now())
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role
  /// Кто добавил (без relation, как authorId у Remark); null — создатель проекта или seed
  invitedById String?
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

/// Приглашение в проект по e-mail (ADR 005). Писем нет: ссылку /join/<token> PM отправляет сам.
/// Принимается регистрацией или входом с этим e-mail (auto-accept) либо по token уже вошедшим пользователем.
model Invitation {
  id               String    @id @default(uuid())
  projectId        String
  /// Нормализованный lower-case e-mail
  email            String
  role             Role
  /// randomBytes(24).toString('base64url') — bearer-способность: у кого ссылка, тот и входит с этой ролью
  token            String    @unique
  invitedById      String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
}

model Document {
  id        String           @id @default(uuid())
  projectId String
  kind      DocumentKind
  title     String
  mime      String
  storageKey String
  status    DocumentStatus   @default(uploaded)
  effectiveAt DateTime?
  project   Project          @relation(fields: [projectId], references: [id])
  chunks    DocumentChunk[]
  createdAt DateTime         @default(now())

  @@index([projectId])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  projectId  String
  documentId String
  section    String?
  page       Int?
  content    String
  /// vector(N) — N = размерность выбранной embedding-модели, одна на индекс
  embedding  Unsupported("vector(1536)")?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
}

model Round {
  id        String      @id @default(uuid())
  projectId String
  number    Int
  status    RoundStatus @default(open)
  project   Project     @relation(fields: [projectId], references: [id])
  remarks   Remark[]
  imports   ImportJob[]

  @@unique([projectId, number])
}

model Remark {
  id             String        @id @default(uuid())
  projectId      String
  roundId        String
  externalId     String?
  pageOrScreen   String?
  description    String        @default("")
  expected       String?
  severity       String?
  status         RemarkStatus  @default(imported)
  duplicateOfId  String?
  /// Порядковый номер в раунде — «№ 12» на карточке
  number         Int
  authorId       String?
  /// Черновик разбора: предложение модели и обоснование (абзацы через пустую строку)
  proposedClass  ProposedClass?
  rationale      String?
  visionFacts    String?
  retestOutcome  RetestOutcome?
  retestExplanation String?
  fixedByUserId  String?
  closedByUserId String?
  closedAt       DateTime?
  round          Round         @relation(fields: [roundId], references: [id])
  screenshots    RemarkScreenshot[]
  citations      EvidenceCitation[]
  runs           AgentRun[]
  verdicts       HumanVerdict[]
  advices        DeveloperAdvice[]
  createdAt      DateTime      @default(now())

  @@index([projectId, status])
  @@index([roundId])
  @@unique([roundId, number])
}

model RemarkScreenshot {
  id        String         @id @default(uuid())
  remarkId  String
  kind      ScreenshotKind
  storageKey String
  width     Int?
  height    Int?
  remark    Remark         @relation(fields: [remarkId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([remarkId])
}

model EvidenceCitation {
  id        String @id @default(uuid())
  remarkId  String
  chunkId   String
  remark    Remark @relation(fields: [remarkId], references: [id], onDelete: Cascade)

  @@index([remarkId])
}

model AgentRun {
  id        String         @id @default(uuid())
  remarkId  String
  projectId String
  mode      String         @default("triage")
  status    AgentRunStatus @default(running)
  model     String?
  inputTokens  Int?
  outputTokens Int?
  costUsd   Decimal?       @db.Decimal(10, 6)
  remark    Remark         @relation(fields: [remarkId], references: [id])
  checkpoints GraphCheckpoint[]
  createdAt DateTime       @default(now())

  @@index([remarkId])
  @@index([status, createdAt])
}

/// Чекпоинт LangGraph (фаза 6): thread_id = AgentRun.id, поэтому interrupt живёт дольше HTTP и рестарта API.
/// blob/metadata/writes — сериализация JsonPlusSerializer (base64), как в MemorySaver, только в Postgres.
model GraphCheckpoint {
  id           String   @id @default(uuid())
  runId        String
  ns           String   @default("")
  checkpointId String
  parentId     String?
  blob         Json
  metadata     Json     @default("{}")
  /// Ожидающие записи нод по ключу «taskId,idx»: [taskId, channel, value]
  writes       Json     @default("{}")
  run          AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([runId, ns, checkpointId])
}

model HumanVerdict {
  id        String      @id @default(uuid())
  remarkId  String
  runId     String?
  userId    String
  code      VerdictCode
  comment   String?
  idempotencyKey String
  remark    Remark      @relation(fields: [remarkId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([runId, idempotencyKey])
  @@index([remarkId])
}

/// Совет разработчика по замечанию в awaiting_pm: не вердикт — статус не меняет, граф не трогает.
/// Один на человека и замечание; можно изменить или снять. PM видит его рядом с вариантом решения.
model DeveloperAdvice {
  id        String      @id @default(uuid())
  remarkId  String
  userId    String
  code      VerdictCode
  comment   String?
  remark    Remark      @relation(fields: [remarkId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([remarkId, userId])
}

/// Загрузка журнала по официальному шаблону (REMARKROUND.md §14). projectId дублирует round.projectId
/// ради прямого SQL-фильтра тенанси; storageKey — исходный файл, чтобы ничего не терять.
model ImportJob {
  id        String      @id @default(uuid())
  projectId String
  roundId   String
  fileName  String
  storageKey String
  round     Round       @relation(fields: [roundId], references: [id])
  rows      ImportRow[]
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model ImportRow {
  id         String          @id @default(uuid())
  jobId      String
  rowNumber  Int
  status     ImportRowStatus
  /// Ячейки строки как есть — человек дописывает, парсер не выдумывает
  rawJson    Json
  /// Почему строка ушла человеку: «пустое описание», «больше ячеек, чем колонок»
  reason     String?
  remarkId   String?
  job        ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
