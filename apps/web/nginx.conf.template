# Конфиг nginx контейнера web — шаблон: entrypoint образа nginx:alpine рендерит его в /etc/nginx/conf.d/default.conf
# при каждом старте (envsubst). Подставляются только переменные API_UPSTREAM, DNS_RESOLVER и LISTEN_IPV6 в фигурных
# скобках (NGINX_ENVSUBST_FILTER в apps/web/Dockerfile) — собственные $переменные nginx ниже не трогаются.
# Один файл на все окружения (docs/PROD.md — compose за Caddy, docs/PROD-RAILWAY.md — Railway); дефолты в Dockerfile:
#   API_UPSTREAM  куда проксировать /api: compose — api:3000, Railway — api.railway.internal:3000
#   DNS_RESOLVER  кем разрешать имя api: без значения — nameserver из /etc/resolv.conf контейнера
#                 (Docker — 127.0.0.11, Railway — [fd12::10]); см. apps/web/docker-entrypoint.d/16-rr-proxy-env.envsh
#   REAL_IP_FROM  с каких адресов верить X-Forwarded-For (список через пробел → /etc/nginx/rr-real-ip.conf):
#                 compose — docker-подсети (пишет Caddy), Railway — «0.0.0.0/0 ::/0» (пишет edge-прокси Railway)

# За прокси (Caddy в compose-проде, edge-прокси Railway) $remote_addr — адрес прокси, и лимит по IP считался бы на всех
# пользователей разом (аудит беты R-H5): настоящий адрес клиента берём из X-Forwarded-For, доверяя только REAL_IP_FROM.
# Прокси перед нами сам стирает X-Forwarded-For, который прислал клиент (Caddy — у недоверенных клиентов, Railway — всегда),
# поэтому recursive on безопасен даже при 0.0.0.0/0: крайний левый адрес записал прокси, а не клиент.
include /etc/nginx/rr-real-ip.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
# Лимит на вход и регистрацию по IP — первая линия (офис за одним NAT — сотни попыток в минуту в 9:00);
# вторая — @nestjs/throttler в API: вошедшие считаются по пользователю, анонимы по IP.
limit_req_zone $binary_remote_addr zone=rr_auth:10m rate=300r/m;
limit_req_status 429;

server {
  listen 80;
  # listen [::]:80 — только если в контейнере есть IPv6 (приватная сеть Railway старых окружений — IPv6-only)
  ${LISTEN_IPV6}
  server_name localhost;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 25m;

  # Имя api — через переменную и resolver, а не литерал в proxy_pass: nginx стартует, даже если api ещё не поднялся,
  # и перечитывает адрес каждые 10 с — Railway выдаёт контейнеру новый приватный адрес на каждый деплой, с литералом
  # nginx запомнил бы старый до своего рестарта. Без URI в proxy_pass путь запроса уходит в api как есть.
  resolver ${DNS_RESOLVER} valid=10s ipv6=on;
  set $api http://${API_UPSTREAM};

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml font/woff2;
  gzip_min_length 1024;

  # Заголовки безопасности SPA (фаза 11). Стили Angular — inline, поэтому style-src 'unsafe-inline';
  # скрипт темы вынесен в theme-init.js, чтобы script-src остался 'self'; кадры приходят как blob: (MediaService).
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  # X-Forwarded-For в api — ровно один адрес: клиент после realip выше. Не $proxy_add_x_forwarded_for: тот дописывал бы
  # адрес к цепочке прокси, и число hop'ов для API зависело бы от окружения. Теперь TRUST_PROXY_HOPS=1 везде.

  # Комната замечания (socket.io): апгрейд до WebSocket, долгое соединение
  location /api/v1/ws {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }

  # Вход, регистрация, смена и сброс пароля — с лимитом. /auth/me и /auth/options грузит каждая вкладка при старте —
  # они идут общим маршрутом /api/ ниже, иначе один bucket на всех выбивал бы 429 на загрузке SPA
  location ~ ^/api/v1/auth/(login|register|password|reset)$ {
    limit_req zone=rr_auth burst=20 nodelay;
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # API в той же origin: фронт ходит на /api/v1 без CORS
  location /api/ {
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # Сборка Angular хеширует имена файлов: кэш на год; index.html — всегда свежий (expires не трогает add_header выше)
  location ~* \.(js|css|woff2)$ {
    expires 1y;
    try_files $uri =404;
  }
  location = /index.html {
    expires -1;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
