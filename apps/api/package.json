    "rag:eval": "tsx src/rag/chunking-eval.ts",
    "evals": "tsc -p tsconfig.evals.json && node dist-evals/src/evals/run-evals.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langfuse/langchain": "5.11.0",
    "@langfuse/openai": "5.11.0",
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@remarkround/db": "workspace:*",
    "@sentry/node": "^10.75.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "jpeg-js": "0.4.4",
    "mammoth": "^1.12.2",
    "nestjs-pino": "^5.1.0",
    "openai": "^7.9.0",
    "pdf-parse": "2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.3",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.17.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/../test/setup.ts"
    ],
    "testTimeout": 60000
