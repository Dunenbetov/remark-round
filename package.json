{
  "name": "remarkround",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "db:generate": "pnpm --filter @remarkround/db generate",
    "db:migrate": "pnpm --filter @remarkround/db migrate",
    "db:migrate:deploy": "pnpm --filter @remarkround/db migrate:deploy",
    "api:dev": "pnpm --filter @remarkround/api dev",
    "web:dev": "pnpm --filter @remarkround/web dev",
    "build": "pnpm -r build",
    "evals": "pnpm --filter @remarkround/api evals"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.6",
      "deepmerge-ts": ">=8.0.0",
      "qs": ">=6.16.0"
    }
  },
  "devDependencies": {
    "railway": "^3.11.0"
  }
}
